{
  "name": "@academy/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "jobs:schedule": "tsx src/jobs/registerSchedules.script.ts",
    "jobs:worker": "tsx watch src/jobs/worker.script.ts",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx prisma/seed.ts",
    "test:webhook": "tsx scripts/sendTestWebhook.ts",
    "debug:conversations": "tsx scripts/printConversations.ts",
    "jobs:trigger": "tsx scripts/triggerJob.ts",
    "admin:create": "tsx scripts/createAdminUser.ts",
    "test:business-queries": "tsx scripts/testBusinessQueries.ts",
    "test:customer-memory": "tsx scripts/testCustomerMemory.ts"
  },
  "dependencies": {
    "@academy/db": "*",
    "@anthropic-ai/sdk": "^0.24.3",
    "@clerk/backend": "^1.5.2",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@google/generative-ai": "^0.21.0",
    "axios": "^1.7.2",
    "bullmq": "^5.7.8",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "form-data": "^4.0.0",
    "ioredis": "^5.4.1",
    "openai": "^4.47.1",
    "puppeteer": "^22.12.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2"
  }
}
