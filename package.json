{
  "name": "academy-whatsapp-automation",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@academy/api",
    "dev:web": "npm run dev --workspace=@academy/web",
    "build:api": "npm run build --workspace=@academy/api",
    "build:web": "npm run build --workspace=@academy/web",
    "typecheck": "npm run typecheck --workspace=@academy/api && npm run typecheck --workspace=@academy/web",
    "db:generate": "npm run generate --workspace=@academy/db",
    "db:migrate": "npm run migrate --workspace=@academy/db",
    "jobs:schedule": "npm run jobs:schedule --workspace=@academy/api",
    "jobs:worker": "npm run jobs:worker --workspace=@academy/api"
  },
  "devDependencies": {
    "typescript": "^5.5.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@5.22.0": true,
    "puppeteer@22.15.0": true
  },
  "dependencies": {
    "razorpay": "^2.9.8"
  }
}
